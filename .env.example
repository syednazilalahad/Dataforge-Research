# Local: leave DATABASE_URL empty for persistent embedded PostgreSQL (.data/db).
# Production: PostgreSQL is mandatory. Configure verified TLS via the connection URL.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
LOCAL_DATABASE_PATH=.data/db
# Set true ONLY to smoke-test a production build locally without PostgreSQL.
ALLOW_LOCAL_DATABASE=false
# offline or compatible. Offline is a deterministic planning aid, not an LLM.
AI_PROVIDER=offline
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=
AI_API_KEY=
# Optional seed account; required by db:seed. Never commit these values.
SEED_EMAIL=
SEED_PASSWORD=
